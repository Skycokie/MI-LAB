# Optional real-time data for Kronos Forecast only.
# Copy to backend/.env and fill in keys. Without keys, Forecast falls back to Yahoo
# (except crypto: HTX public klines work without keys).

# Alpaca Market Data (US stocks / ETFs) — free paper account at https://alpaca.markets
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# HTX (Huobi) — public market klines need no key.
# Optional private keys only if you later add trading / account calls:
# HTX_ACCESS_KEY=
# HTX_SECRET_KEY=

# Financial Datasets (news per ticker) - https://financialdatasets.ai/
# Optional: without it the News tab falls back to Alpaca news.
FINANCIAL_DATASETS_API_KEY=

# Capital.com API (live CFD quotes: indices / gold / oil / FX) - free demo
# account at https://capital.com, then Settings > API integrations.
# Requires 2FA enabled before generating the API key.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_API_PASSWORD=
# CAPITAL_ENV: demo | live
CAPITAL_ENV=demo
