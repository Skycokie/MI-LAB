# Optional real-time data for Kronos Forecast only.
# Copy to backend/.env and fill in keys. Without keys, Forecast falls back to Yahoo
# (except crypto: HTX public klines work without keys).

# Alpaca Market Data (US stocks / ETFs) — free paper account at https://alpaca.markets
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# HTX (Huobi) — public market klines need no key.
# Optional private keys only if you later add trading / account calls:
# HTX_ACCESS_KEY=
# HTX_SECRET_KEY=
